# Copy this file to .env in the repository root, add the key there, and restart the backend.
# Do not put this key in frontend/.env and never commit the populated root .env file.
# Without a key, Revia uses its deterministic offline baselines.
OPENAI_API_KEY=

# Optional model override used for both answer generation and LLM-as-a-Judge.
OPENAI_MODEL=gpt-5-mini
